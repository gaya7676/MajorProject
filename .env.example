# Credixa Environment Variables Configuration
# Copy this file to .env and fill in your values

# ===== LLM API Keys (Required for AI features) =====
# Choose ONE provider and set its API key
# The system will automatically use the configured provider

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Base URL (optional, for custom endpoints)
# OPENAI_API_BASE_URL=https://api.openai.com/v1/chat/completions

# ===== Blockchain Configuration (Optional) =====
# For skill verification on blockchain

# EVM RPC URL (e.g., Ethereum, Polygon, or local Ganache)
# EVM_RPC_URL=http://127.0.0.1:8545

# ResumeRegistry Smart Contract Address
# RESUME_REGISTRY_ADDRESS=0x...

# ===== Application Configuration =====

# Data Directory (optional, defaults to ./backend/data)
# CREDIXA_DATA_DIR=./backend/data

# Application Secret (optional, auto-generated if not provided)
# APP_SECRET=your_random_secret_here

# Environment Mode
# NODE_ENV=production

# Public Base URL (for QR code verification links)
# PUBLIC_BASE_URL=https://your-domain.com

# ===== Notes =====
# - At least ONE LLM API key is REQUIRED for assessments to work
# - Blockchain configuration is OPTIONAL - system works without it
# - Never commit the actual .env file to version control
# - Keep API keys secure and never expose them in frontend code
